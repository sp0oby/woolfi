# Copy to .env and fill in. NEVER commit the real .env.
#
# Default behaviour with none of these set: dry-run only. The keeper simulates
# checkStructuralBreak() for every live pool in the manifest, logs the outcomes as JSON, and
# never broadcasts. It also refuses to run against any chain other than 4663.

# Robinhood Chain RPC used for both simulation and (if enabled) broadcast.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Path to the deployment manifest. Defaults to the frontend copy so all three services read
# the same file. Only pools with launchStatus="live" + receipt + startBlock are keepable.
KEEPER_MANIFEST=../frontend/lib/deployments/robinhood.json

# Milliseconds between ticks. 0 = run once and exit (useful under cron / a job runner).
KEEPER_CADENCE_MS=60000

# Optional RebalanceKeeper contract. When set, ticks call keep(key) on it instead of
# hook.checkStructuralBreak(key). Leave blank or 0x0 to hit the hook directly.
KEEPER_ADDRESS=

# Set to "true" to actually send transactions. Requires KEEPER_PRIVATE_KEY.
# Anything else (unset, "false", "0") = dry-run.
KEEPER_BROADCAST=false

# Signer used only when KEEPER_BROADCAST=true. Use a dedicated, minimally-funded EOA.
# Do NOT put a treasury / multisig key here.
KEEPER_PRIVATE_KEY=

# When "true" (the default), any pool whose simulation fails makes the process exit 1 after
# logging a {tick,pools,failures,ready} summary. Set to "false" to keep looping instead.
KEEPER_FAIL_ON_ERROR=true

# Optional. If set, the same summary is POSTed here as JSON whenever failures > 0.
# A failing webhook is logged and ignored; it never crashes the keeper.
KEEPER_ALERT_WEBHOOK=
