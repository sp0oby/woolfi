# Copy to .env.local and fill in. Never commit the real .env.local.

# Production builds warn when NEXT_PUBLIC_WC_PROJECT_ID, NEXT_PUBLIC_INDEXER_URL or
# NEXT_PUBLIC_SITE_URL is missing, and fail once lib/deployments/robinhood.json is live.

# WalletConnect project id (cloud.walletconnect.com). Browser-extension wallets work without it;
# phone wallets connecting by QR code need it.
NEXT_PUBLIC_WC_PROJECT_ID=

# Public origin of the site (canonical URLs, link previews, sitemap). Optional on Vercel, which
# falls back to the project's production URL.
NEXT_PUBLIC_SITE_URL=

# Required for swap/fee history. Defaults to the local Ponder API.
NEXT_PUBLIC_INDEXER_URL=http://localhost:42069

# Optional dedicated Robinhood RPC for live contract reads.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
