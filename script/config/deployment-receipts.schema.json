{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Receipt-backed WoolFi deployment journal",
  "type": "object",
  "required": ["chainId", "receipts"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "chainId": {"const": 4663},
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operationId", "transactionHash", "blockNumber", "contracts", "manifest"],
        "additionalProperties": false,
        "properties": {
          "operationId": {"type": "string", "minLength": 1},
          "transactionHash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
          "blockNumber": {"type": "integer", "minimum": 1},
          "contracts": {
            "type": "object",
            "additionalProperties": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"}
          },
          "manifest": {"type": "object"}
        }
      }
    }
  }
}
