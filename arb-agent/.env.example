# WoolFi arbitrage agent. Copy to .env and fill in. Never commit a real .env.
# Dry-run is the default: the agent simulates every trade and logs it, but sends nothing until
# ARB_BROADCAST=true. The agent refuses any manifest whose chainId is not 4663.

# RPC for Robinhood Chain. The public endpoint works for light use; use a paid one (Alchemy,
# QuickNode) for a 24/7 bot. See docs/runbooks/rpc-providers.md.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Deployment manifest the frontend, indexer and keeper share. Pools are only scanned once its
# launchStatus is "live".
ARB_MANIFEST=../frontend/lib/deployments/robinhood.json

# Address of a deployed WoolFiArbExecutor (script/DeployArbExecutor.s.sol). Ownerless and
# permissionless: you can deploy your own or use the shared one. Required to simulate trades.
ARB_EXECUTOR=

# Key that signs trades and receives profit. Only needs gas money (ETH on Robinhood Chain).
# Use a dedicated hot wallet holding nothing else.
ARB_PRIVATE_KEY=
# Set to true to actually send trades.
ARB_BROADCAST=false

# Loop cadence in milliseconds.
ARB_CADENCE_MS=15000
# Minimum simulated profit after gas, in USD, before a trade is sent.
ARB_MIN_PROFIT_USD=1
# Ignore pools closer to fair than this (bps). Should exceed the WoolFi base fee plus v3 fee.
ARB_MIN_DRIFT_BPS=40
# Candidate trade sizes in USD; the agent simulates each and keeps the most profitable.
ARB_SIZES_USD=250,500,1000,2000,5000,10000

# Uniswap v3 on Robinhood Chain (defaults shown).
ARB_V3_FACTORY=0x1f7d7550b1b028f7571e69a784071f0205fd2efa
ARB_V3_QUOTER=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7

# Optional AI narrator. If set, every ARB_EXPLAIN_EVERY_TICKS ticks (and after each executed
# trade) the recent logs are sent to the Claude API for a 3-sentence plain-English summary.
# It never affects trading decisions; API errors are logged and ignored.
ANTHROPIC_API_KEY=
ARB_EXPLAIN_EVERY_TICKS=20
# Optional: POST each summary to a Discord/Slack-style webhook.
ARB_REPORT_WEBHOOK=
