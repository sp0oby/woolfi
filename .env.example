# Copy to .env and fill in. NEVER commit the real .env.
# RPC endpoints (used by foundry.toml [rpc_endpoints] and fork tests)
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Robinhood Chain mainnet (chain ID 4663) canonical deployment inputs.
POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
STAKING_TOKEN=0x9fbe210007dDd8389f98d0253018e65CC48b9D24
ROBINHOOD_WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
ROBINHOOD_USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
ROBINHOOD_MSTR=0xec262a75e413fAfD0dF80480274532C79D42da09

# CreatePool production artifact metadata (required for Robinhood --broadcast only).
POOL_SLUG=
TOKEN0_SYMBOL=
TOKEN1_SYMBOL=

# Per-stock oracle adapter inputs. Resolve these from Chainlink immediately before deployment.
STOCK_TOKEN=
CHAINLINK_FEED=
SEQUENCER_UPTIME_FEED=
FEED_HEARTBEAT=
SEQUENCER_GRACE_PERIOD=3600

# Deployer — prefer a keystore/hardware signer over a raw key.
# For local/anvil only. Do NOT put a funded mainnet key here.
DEPLOYER_PRIVATE_KEY=
# Required in addition to Robinhood chain ID 4663 for every production --broadcast/--resume.
# Leave false for dry-runs. The 18-pool coordinator also requires nonAtomicTransactionsAcknowledged.
CONFIRM_MAINNET=false

# Coordinated readiness:
# python script/robinhood_batch.py readiness --config script/config/robinhood-batch.example.json
# Copy that example outside version control and replace every zero/empty launch-approval field.

# Etherscan/Basescan API key for contract verification
BASESCAN_API_KEY=

# Verified Base cbBTC/USD Chainlink feed (8 decimals). Set this in .env to enable the
# adapter fork test (test/fork). Leave unset to skip it (e.g. in CI without a Base RPC).
BASE_CBBTC_USD_FEED=0x07DA0E54543a844a80ABE69c8A12F22B3aA59f9D
