# Copy to .env.local and fill in. Never commit the real .env.

# RPC endpoints
PONDER_RPC_URL_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com

# WoolFi contract addresses (from script/Deploy.s.sol + script/CreatePool.s.sol)
PONDER_HOOK_ADDRESS=
PONDER_PM_ADDRESS=
# Comma-separated vault=poolId mappings. Addresses and pool IDs must be unique.
# PONDER_VAULTS=0xVault1=0xPoolId1,0xVault2=0xPoolId2
PONDER_VAULTS=

# Earliest block the indexer should scan from (the block the contracts were deployed in)
PONDER_START_BLOCK=

# Ponder's local API port (default 42069)
PORT=42069
