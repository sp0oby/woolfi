# Copy to .env.local and fill in. Never commit the real .env.
#
# When frontend/lib/deployments/robinhood.json has launchStatus="live", the indexer reads
# addresses and start blocks from it and these env values must MATCH the manifest or
# ponder.config.ts throws at boot. Env values are the fallback for non-live / local runs.

# RPC endpoints
PONDER_RPC_URL_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com

# How often to poll for new blocks (ms). Omit for Ponder's default.
PONDER_POLLING_INTERVAL_MS=

# WoolFi contract addresses (from script/Deploy.s.sol + script/CreatePool.s.sol)
PONDER_HOOK_ADDRESS=
PONDER_PM_ADDRESS=
# UrufuFeeRebateDistributor. Leave blank if rebates are not deployed.
PONDER_REBATE_ADDRESS=
# Comma-separated vault=poolId mappings. Addresses and pool IDs must be unique.
# PONDER_VAULTS=0xVault1=0xPoolId1,0xVault2=0xPoolId2
PONDER_VAULTS=

# Earliest block the indexer should scan from (the block the contracts were deployed in).
# Applies to every contract unless a per-contract override below is set.
PONDER_START_BLOCK=
# Optional per-contract overrides; each falls back to PONDER_START_BLOCK.
PONDER_HOOK_START_BLOCK=
PONDER_PM_START_BLOCK=
PONDER_REBATE_START_BLOCK=
PONDER_VAULT_START_BLOCK=

# Ponder's local API port (default 42069)
PORT=42069
